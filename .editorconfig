# Code style for the C# game (dotnet format and the analyzers read this).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

# Braces on their own line, as the code already does.
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:suggestion

# Constants are SCREAMING_SNAKE (the project's naming rule).
dotnet_naming_rule.constants_are_screaming_snake.severity = suggestion
dotnet_naming_rule.constants_are_screaming_snake.symbols = constants
dotnet_naming_rule.constants_are_screaming_snake.style = screaming_snake
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.screaming_snake.capitalization = all_upper
dotnet_naming_style.screaming_snake.word_separator = _

[*.{json,csproj,slnx}]
indent_style = space
indent_size = 2
